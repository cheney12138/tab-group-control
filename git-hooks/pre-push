#!/usr/bin/env bash
# 铁律第二层: 推送前扫一遍"将要推上去的提交"(docs/adr/0008)。
# 兜住 commit-msg 漏掉的路径: --no-verify、别的机器上没装钩子、IDE/GitHub 网页端提交。
# git push --no-verify 可以绕过(逃生门, 但铁律要求别这么干)。
set -u
self_dir="$(cd "$(dirname "$0")" && pwd -P)"
ranges=()
while read -r _local_ref local_oid _remote_ref remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac  # 删分支
  case "$remote_oid" in
    0000000000000000000000000000000000000000) ranges+=("$local_oid") ;;         # 新分支: 整条历史
    *) ranges+=("${remote_oid}..${local_oid}") ;;
  esac
done
[ ${#ranges[@]} -eq 0 ] && exit 0
exec python3 "$self_dir/ai-trailer-guard.py" check "${ranges[@]}"
